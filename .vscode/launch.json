{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API AdonisJS: Debug",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/api",
      "program": "${workspaceFolder}/apps/api/ace",
      "args": [
        "serve",
        "--watch"
      ],
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "sourceMaps": true,
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ]
    }
  ]
}
